################################################################
# 'Staging' workload inputs
################################################################

cloud_name     = "tf-secure-baseline"
environment    = "staging"
primary_region = "us-east-1"

deployment_profile = "development"

# Add only explicitly reviewed application domains. Platform-required Ubuntu
# domains remain module-owned and must not be repeated here.
allowed_egress_domains = []

secops_emails = [
  "jeffrey.williams@gmail.com"
]

bucket_admin_principals = [
  "arn:aws:iam::123456789012:root",
  "arn:aws:iam::123456789012:role/tf-secure-baseline-staging-github-apply-role"
]

break_glass_trusted_principal_arns = [
  "arn:aws:iam::0123456789012:root"
]
