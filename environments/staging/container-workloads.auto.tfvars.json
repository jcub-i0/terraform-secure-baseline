{
  "repositories": {},
  "ecs_services": {
    "test": {
      "repository_name": "test",
      "image_digest": "sha256:392dc3646e85bc618995acf56dbff44b8e5127421574858897cd5c2e0559f45e",
      "container_port": 8080,
      "cpu": 512,
      "memory": 1024,
      "desired_count": 3,
      "scaling": null,
      "deployment": {
        "minimum_healthy_percent": 100,
        "maximum_percent": 200,
        "health_check_grace_period_seconds": 60
      },
      "health_check": {
        "command": [
          "CMD-SHELL",
          "busybox wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 3,
        "start_period": 15
      },
      "depends_on": [
        {
          "container_name": "readiness",
          "condition": "HEALTHY"
        }
      ],
      "sidecars": {
        "init": {
          "repository_name": "test",
          "image_digest": "sha256:392dc3646e85bc618995acf56dbff44b8e5127421574858897cd5c2e0559f45e",
          "essential": false,
          "dependency_rank": 0,
          "command": [
            "sh",
            "-c",
            "echo m1-init-complete; exit 0"
          ],
          "read_only_root_filesystem": true
        },
        "readiness": {
          "repository_name": "test",
          "image_digest": "sha256:392dc3646e85bc618995acf56dbff44b8e5127421574858897cd5c2e0559f45e",
          "essential": true,
          "dependency_rank": 1,
          "depends_on": [
            {
              "container_name": "init",
              "condition": "SUCCESS"
            }
          ],
          "command": [
            "sh",
            "-c",
            "sleep 20; touch /tmp/m1-ready; echo m1-sidecar-ready; while :; do sleep 3600; done"
          ],
          "health_check": {
            "command": [
              "CMD-SHELL",
              "test -f /tmp/m1-ready"
            ],
            "interval": 5,
            "timeout": 3,
            "retries": 3,
            "start_period": 30
          },
          "cpu_units": 64,
          "memory_limit_mib": 256,
          "memory_reservation_mib": 128
        }
      },
      "ingress": {
        "priority": 100,
        "path_patterns": [
          "/*"
        ],
        "health_check_path": "/health"
      }
    }
  }
}
