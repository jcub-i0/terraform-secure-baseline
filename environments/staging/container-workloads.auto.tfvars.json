{
  "repositories": {},
  "ecs_services": {
    "test": {
      "repository_name": "test",
      "image_digest": null,
      "container_port": 8080,
      "cpu": 256,
      "memory": 512,
      "desired_count": 3,
      "scaling": null,
      "deployment": {
        "minimum_healthy_percent": 100,
        "maximum_percent": 200,
        "health_check_grace_period_seconds": 60
      },
      "ingress": {
        "priority": 100,
        "path_patterns": [
          "/*"
        ],
        "health_check_path": "/health"
      },
      "database_access": true,
      "environment_variables": {
        "M3_DB_PORT": "5432",
        "M3_DB_NAME": "appdb",
        "M3_DB_USER": "m3_canary_app"
      },
      "ssm_parameters": {
        "M3_DB_HOST": "arn:aws:ssm:us-east-1:027326805885:parameter/tf-secure-baseline/staging/m3-canary/db-host"
      },
      "secrets_manager_secrets": {
        "M3_DB_PASSWORD": "arn:aws:secretsmanager:us-east-1:027326805885:secret:tf-secure-baseline-staging/m3-canary/db-password-xpxdOp",
        "M3_CANARY_TOKEN": "arn:aws:secretsmanager:us-east-1:027326805885:secret:tf-secure-baseline-staging/m3-canary/api-token-4pHmB5"
      },
      "task_execution_kms_key_arns": [],
      "health_check": {
        "command": [
          "CMD-SHELL",
          "python -c \"from urllib.request import urlopen; assert urlopen('http://127.0.0.1:8080/health',timeout=2).status == 200\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "start_period": 30
      }
    }
  }
}
