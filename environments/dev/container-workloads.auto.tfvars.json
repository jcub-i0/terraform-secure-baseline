{
  "repositories": {},
  "ecs_services": {
    "test": {
      "repository_name": "test",
      "image_digest": null,
      "container_port": 8080,
      "cpu": 256,
      "memory": 512,
      "desired_count": 3,
      "scaling": null,
      "deployment": {
        "minimum_healthy_percent": 100,
        "maximum_percent": 200,
        "health_check_grace_period_seconds": 60
      },
      "ingress": {
        "priority": 100,
        "path_patterns": [
          "/*"
        ],
        "health_check_path": "/health"
      },
      "health_check": {
        "command": [
          "CMD-SHELL",
          "busybox wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "start_period": 10
      }
    }
  }
}
