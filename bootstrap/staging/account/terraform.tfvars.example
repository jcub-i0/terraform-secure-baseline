cloud_name     = "tf-secure-baseline"
environment    = "staging"
primary_region = "us-east-1"

################################################################
# GitHub-related variables
################################################################
owner_github                    = "example-org"
repo_github                     = "terraform-secure-baseline"
enable_github_oidc              = true
enable_apply_role_github        = true
branches_plan_github            = ["main"]
branches_apply_github           = ["main"]
allow_pull_requests_plan_github = true
environment_apply_github        = "staging"
tf_state_bucket_arn             = "arn:aws:s3:::tf-secure-baseline-staging-state"
tf_state_bucket_cmk_arn         = "arn:aws:kms:us-east-1:444444444444:key/00000000-0000-0000-0000-000000000000"

enable_image_publisher_role_github = true

branches_image_publisher_github = [
  "main",
]
